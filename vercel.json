{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/audio/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self), payment=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com https://routes.googleapis.com; font-src 'self'; frame-ancestors 'none'; img-src 'self' data: https://maps.googleapis.com; manifest-src 'self'; media-src 'self'; object-src 'none'; script-src 'self'; style-src 'self'; worker-src 'self'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/chill", "destination": "/index.html" },
    { "source": "/chill/", "destination": "/index.html" },
    { "source": "/chill/weather", "destination": "/index.html" },
    { "source": "/chill/traffic", "destination": "/index.html" },
    { "source": "/chill/privacy", "destination": "/privacy.html" },
    { "source": "/chill/terms", "destination": "/terms.html" },
    { "source": "/chill/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/chill/audio/(.*)", "destination": "/audio/$1" },
    { "source": "/chill/weather-photos/(.*)", "destination": "/weather-photos/$1" },
    { "source": "/chill/manifest.webmanifest", "destination": "/manifest.webmanifest" },
    { "source": "/chill/sw.js", "destination": "/sw.js" },
    { "source": "/chill/workbox-(.*).js", "destination": "/workbox-$1.js" },
    { "source": "/chill/(.*).png", "destination": "/$1.png" },
    { "source": "/chill/(.*).svg", "destination": "/$1.svg" },
    { "source": "/chill/(.*).js", "destination": "/$1.js" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
