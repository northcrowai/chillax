# Google Maps Platform keys used by the optional Traffic page.
#
# This public repository intentionally contains no real keys. Create your own
# billing-enabled Google Cloud project and use two separate, restricted keys:
# - Routes API only for VITE_GOOGLE_ROUTES_API_KEY
# - Maps Static API only for VITE_GOOGLE_STATIC_MAPS_API_KEY
#
# VITE_ values are embedded in the browser bundle. They are not secrets: apply
# website/referrer restrictions, API restrictions, quotas, and billing alerts.
# See README.md and AGENTS.md before adding values. Never commit .env.local.

VITE_GOOGLE_ROUTES_API_KEY=
VITE_GOOGLE_STATIC_MAPS_API_KEY=
