# Google Maps Platform keys used by the optional Traffic page.
#
# These VITE_ values are intentionally browser-visible. Never treat them as
# secrets. Before adding real values, use separate keys for each API and apply:
# - API restrictions (Routes API or Maps Static API only)
# - Website/referrer restrictions for the domains that host this deployment
# - Conservative per-day quotas and billing alerts

VITE_GOOGLE_ROUTES_API_KEY=
VITE_GOOGLE_STATIC_MAPS_API_KEY=
